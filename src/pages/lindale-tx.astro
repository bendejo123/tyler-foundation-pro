---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import CTASection from '../components/CTASection.astro';
import SignsList from '../components/SignsList.astro';

const signs = [
  'Cracks in drywall, especially diagonal cracks near door frames',
  'Doors or windows sticking or failing to latch',
  'Sloping or uneven floors',
  'Gaps forming between walls and ceilings or floors',
  'Exterior brick cracks or gaps in mortar joints',
];
---

<Layout
  title="Foundation Repair in Lindale, TX | Tyler Foundation Pros"
  description="Foundation cracking or settling in Lindale, TX? Tyler Foundation Pros connects Lindale homeowners with licensed foundation repair contractors. Free inspections. Call (903) 582-7837."
>
  <!-- Hero -->
  <HeroSection
    h1="Expert Foundation Repair in Lindale, TX"
    subheading="Tyler Foundation Pros connects Lindale homeowners with licensed local foundation repair contractors — fast response, free inspections, local expertise."
    buttonText="Call (903) 582-7837 — Free Lindale Inspection"
  />

  <!-- Intro -->
  <section class="py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-gray-700 text-lg mb-4">
        Lindale is one of the fastest-growing communities in East Texas, and with that growth comes a real foundation challenge: new construction homes built on the same expansive red clay soil that's been cracking foundations throughout Smith and Cherokee Counties for generations.
      </p>
      <p class="text-gray-700 text-lg">
        Whether you're in a newer subdivision near Pinkerton Elementary or an older home near downtown Lindale, Tyler Foundation Pros connects homeowners throughout the Lindale area with licensed local foundation repair contractors — at no cost to get started.
      </p>
    </div>
  </section>

  <!-- Why Lindale Homes Develop Problems -->
  <section class="bg-gray-50 py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">Why Lindale Homes Develop Foundation Problems</h2>
      <p class="text-gray-700 mb-4">
        The clay-heavy soil in the Lindale area is highly reactive to moisture. During Lindale's wet seasons, the soil swells and pushes up against your foundation. During dry East Texas summers, it contracts and pulls away — leaving voids that your foundation slowly sinks into.
      </p>
      <p class="text-gray-700">
        New construction in Lindale is particularly vulnerable during the first five to ten years, as soil that was disturbed during construction compacts and settles unevenly beneath the slab.
      </p>
    </div>
  </section>

  <!-- Signs -->
  <section class="py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-6">Signs You Need Foundation Repair in Lindale</h2>
      <SignsList items={signs} />
    </div>
  </section>

  <!-- Services -->
  <section class="py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-6">Foundation Services We Provide in Lindale</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded p-5">
          <h3 class="font-bold mb-2"><a href="/slab-foundation-repair" class="hover:underline text-brand">Slab Foundation Repair</a></h3>
          <p class="text-gray-600 text-sm">Steel push pier systems for slab foundations in Lindale's newer subdivisions — driven past reactive clay to stable load-bearing soil.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded p-5">
          <h3 class="font-bold mb-2"><a href="/pier-beam-repair" class="hover:underline text-brand">Pier &amp; Beam Repair</a></h3>
          <p class="text-gray-600 text-sm">Beam replacement, pier resetting, and crawl space leveling for older Lindale homes near downtown.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded p-5">
          <h3 class="font-bold mb-2"><a href="/house-leveling" class="hover:underline text-brand">House Leveling</a></h3>
          <p class="text-gray-600 text-sm">Correcting differential settlement to restore level floors and fix sticking doors and windows.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded p-5">
          <h3 class="font-bold mb-2"><a href="/commercial-foundation-repair" class="hover:underline text-brand">Commercial Repair</a></h3>
          <p class="text-gray-600 text-sm">Foundation stabilization for Lindale commercial buildings along US-69 and the IH-20 corridor.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Cost -->
  <section class="bg-gray-50 py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">What Does Foundation Repair Cost in Lindale?</h2>
      <p class="text-gray-700 mb-4">
        Foundation repair in Lindale typically runs between <strong>$3,500 and $12,000</strong> depending on the number of piers required and the severity of the settlement. Most Lindale homes need between 4 and 10 piers. Each steel pier runs approximately $800–$1,400 installed.
      </p>
      <p class="text-gray-700">
        The free inspection will tell you exactly how many piers your foundation needs and give you a written cost estimate with no obligation. See our full <a href="/foundation-repair-cost-tyler-tx" class="text-brand font-semibold hover:underline">East Texas foundation repair cost guide</a> for more detail.
      </p>
    </div>
  </section>

  <!-- Free Inspection -->
  <section class="py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">Free Foundation Inspection for Lindale Homeowners</h2>
      <p class="text-gray-700 mb-4">
        We serve Lindale and the surrounding Smith and Cherokee County area with no-cost inspections. Call our local (903) number and we'll schedule a visit at your convenience — typically within 48 hours.
      </p>
      <p class="text-gray-700">
        We also serve nearby communities including <a href="/whitehouse-tx" class="text-brand font-semibold hover:underline">Whitehouse</a>, <a href="/bullard-tx" class="text-brand font-semibold hover:underline">Bullard</a>, <a href="/chandler-tx" class="text-brand font-semibold hover:underline">Chandler</a>, and <a href="/jacksonville-tx" class="text-brand font-semibold hover:underline">Jacksonville</a>.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    heading="Schedule Your Free Lindale Inspection"
    subtext="Local experts. No charge. No pressure. We'll assess your foundation and give you an honest written estimate — typically within 48 hours."
    buttonText="Call (903) 582-7837 — Free Lindale Inspection"
  />
</Layout>
