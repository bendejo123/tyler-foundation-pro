---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import TrustBar from '../components/TrustBar.astro';
import CTASection from '../components/CTASection.astro';
import SignsList from '../components/SignsList.astro';

const warningSigns = [
  'Cracks in your drywall, especially diagonal cracks near door frames and windows',
  'Doors or windows that stick, won\'t latch, or have visible gaps at the corners',
  'Floors that feel bouncy, slope toward one side, or have visible dips',
  'Gaps between your walls and the ceiling or floor',
  'Cracks in your brick exterior or mortar joints',
  'Water pooling near your foundation after rain',
];
---

<Layout
  title="Foundation Repair in Tyler, TX | Free Inspection | Tyler Foundation Pros"
  description="Tyler Foundation Pros fixes cracked, settling, and sinking foundations in Tyler and East Texas. Call for a free inspection. Fast response, local experts."
>
  <!-- Hero -->
  <HeroSection
    h1="Expert Foundation Repair in Tyler, TX"
    subheading="East Texas clay soil is relentless. It swells in the rain, shrinks in the drought, and puts constant pressure on your home's foundation. We connect you with local licensed contractors who get it fixed — fast and right."
    buttonText="Call for a Free Inspection → (903) 582-7837"
  />

  <!-- Trust Bar -->
  <TrustBar />

  <!-- Why Tyler Homes Have Foundation Problems -->
  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-6">Why Tyler Homes Have Foundation Problems</h2>
      <p class="text-gray-700 text-lg mb-4">
        East Texas sits on some of the most expansive clay soil in the country. In Smith County and the surrounding region, this clay absorbs water and swells during wet seasons — then contracts sharply during summer droughts. Your home's concrete slab or pier-and-beam structure goes through this cycle year after year.
      </p>
      <p class="text-gray-700 text-lg">
        The result? Cracks in your walls and ceilings. Doors and windows that stick or won't close. Floors that slope. Gaps between your walls and the ceiling. These aren't cosmetic problems. Left untreated, foundation movement causes permanent structural damage that gets more expensive the longer you wait.
      </p>
    </div>
  </section>

  <!-- Services Section -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold mb-10 text-center">Our Foundation Repair Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white border border-gray-200 rounded p-6 flex flex-col">
          <h3 class="text-xl font-bold mb-3">Slab Foundation Repair</h3>
          <p class="text-gray-600 text-sm flex-grow mb-4">
            Most Tyler homes are built on concrete slabs. When the clay soil underneath shifts, your slab shifts with it. Licensed contractors in our network use steel pier systems and polyurethane foam to stabilize and lift your slab back to its original position.
          </p>
          <a href="/slab-foundation-repair" class="text-brand font-semibold text-sm hover:underline">Learn More &rarr;</a>
        </div>
        <div class="bg-white border border-gray-200 rounded p-6 flex flex-col">
          <h3 class="text-xl font-bold mb-3">Pier &amp; Beam Repair</h3>
          <p class="text-gray-600 text-sm flex-grow mb-4">
            Tyler's historic neighborhoods — from the Azalea District to Oakwood — are filled with older pier-and-beam homes. Licensed contractors in our network replace rotted beams, reset settled piers, and re-level your floor to factory spec.
          </p>
          <a href="/pier-beam-repair" class="text-brand font-semibold text-sm hover:underline">Learn More &rarr;</a>
        </div>
        <div class="bg-white border border-gray-200 rounded p-6 flex flex-col">
          <h3 class="text-xl font-bold mb-3">House Leveling</h3>
          <p class="text-gray-600 text-sm flex-grow mb-4">
            If your floors are sloping or your home feels "off," your foundation has likely settled unevenly. The house leveling process corrects differential settlement and restores your home's structural integrity.
          </p>
          <a href="/house-leveling" class="text-brand font-semibold text-sm hover:underline">Learn More &rarr;</a>
        </div>
        <div class="bg-white border border-gray-200 rounded p-6 flex flex-col">
          <h3 class="text-xl font-bold mb-3">Commercial Foundation Repair</h3>
          <p class="text-gray-600 text-sm flex-grow mb-4">
            Office buildings, retail spaces, and warehouses in East Texas face the same soil problems as homes — at larger scale. Licensed contractors in our network handle commercial jobs of all sizes with minimal disruption to your operation.
          </p>
          <a href="/commercial-foundation-repair" class="text-brand font-semibold text-sm hover:underline">Learn More &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area Section -->
  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-6">Serving Tyler and the Surrounding Area</h2>
      <p class="text-gray-700 text-lg mb-4">
        We serve homeowners and businesses throughout Smith County and beyond, including:
      </p>
      <div class="flex flex-wrap gap-3 mb-6">
        {['Lindale', 'Whitehouse', 'Bullard', 'Flint', 'Hideaway', 'Chandler', 'Longview', 'Jacksonville', 'Athens', 'Canton'].map((city) => (
          <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded text-sm font-medium">{city}</span>
        ))}
      </div>
      <p class="text-gray-600 text-sm">
        Not sure if we cover your area? Call us at <a href="tel:9035827837" class="text-brand font-semibold hover:underline">(903) 582-7837</a> — we'll let you know within minutes.
      </p>
    </div>
  </section>

  <!-- Warning Signs -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-6">Warning Signs to Watch For</h2>
      <SignsList items={warningSigns} />
      <p class="mt-6 text-gray-700">
        If you're seeing any of these, don't wait. Foundation problems compound over time. A repair that costs $5,000 today can become a $25,000 job in two years.
      </p>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold mb-3 text-center">What East Texas Homeowners Say</h2>
      <p class="text-gray-500 text-center text-sm mb-10">Reviews from homeowners we've connected with licensed local contractors.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
          <div class="flex mb-3">
            <span class="text-yellow-400 text-lg">★★★★★</span>
          </div>
          <p class="text-gray-700 text-sm mb-4">"We had cracks running across our living room walls and our back door wouldn't close. Tyler Foundation Pros connected us with a local crew who had piers installed in two days. The cracks stopped spreading immediately."</p>
          <p class="font-semibold text-sm">— Sandra M., Tyler, TX</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
          <div class="flex mb-3">
            <span class="text-yellow-400 text-lg">★★★★★</span>
          </div>
          <p class="text-gray-700 text-sm mb-4">"Called on a Tuesday, had an inspector at my house Thursday morning. They found the problem, gave me a written estimate with no pressure whatsoever. Very professional. Floors are level again."</p>
          <p class="font-semibold text-sm">— James R., Lindale, TX</p>
        </div>
        <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
          <div class="flex mb-3">
            <span class="text-yellow-400 text-lg">★★★★★</span>
          </div>
          <p class="text-gray-700 text-sm mb-4">"East Texas clay destroyed our slab over 10 years. These guys explained exactly what happened and why. Repair came with a lifetime transferable warranty. Worth every penny."</p>
          <p class="font-semibold text-sm">— Patricia W., Whitehouse, TX</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-10">Frequently Asked Questions</h2>
      <div class="space-y-6">
        <div class="border-b border-gray-200 pb-6">
          <h3 class="text-lg font-bold mb-2">How much does foundation repair cost in Tyler, TX?</h3>
          <p class="text-gray-700">Foundation repair in Tyler typically ranges from $3,500 to $15,000 depending on the severity of the damage and the number of piers required. Minor repairs involving 2–4 piers average $4,000–$6,000. Severe settlement affecting the entire slab can run $10,000–$20,000. The only way to get an accurate number is a free on-site inspection — call us at <a href="tel:9035827837" class="text-brand font-semibold hover:underline">(903) 582-7837</a> and we'll schedule one at no charge. See our full <a href="/foundation-repair-cost-tyler-tx" class="text-brand font-semibold hover:underline">Tyler foundation repair cost guide</a>.</p>
        </div>
        <div class="border-b border-gray-200 pb-6">
          <h3 class="text-lg font-bold mb-2">What causes foundation problems in Tyler, Texas?</h3>
          <p class="text-gray-700">The primary cause is East Texas's expansive clay soil — specifically the Beaumont and Houston clay series that runs through Smith County. This clay absorbs water and swells in wet seasons, then contracts and pulls away from your foundation during summer droughts. This constant movement is what causes cracking, settling, and shifting. Tree roots near the foundation can worsen the problem by drawing moisture unevenly from the soil.</p>
        </div>
        <div class="border-b border-gray-200 pb-6">
          <h3 class="text-lg font-bold mb-2">How do I know if I need foundation repair?</h3>
          <p class="text-gray-700">The most common warning signs are: diagonal cracks in drywall near door frames or windows, doors or windows that stick or won't latch properly, floors that slope or feel uneven, gaps forming between walls and the ceiling or floor, and cracks in exterior brick or mortar joints. If you notice one or more of these, it's worth getting a free inspection — foundation problems almost always get worse over time, not better.</p>
        </div>
        <div class="border-b border-gray-200 pb-6">
          <h3 class="text-lg font-bold mb-2">How long does foundation repair take?</h3>
          <p class="text-gray-700">Most residential slab repairs in Tyler are completed in one to two days. The number of piers needed determines the timeline — a small 4-pier job might be done in a single day, while a larger 12–15 pier project typically takes two days. Pier and beam repairs often take one to three days depending on the scope.</p>
        </div>
        <div class="border-b border-gray-200 pb-6">
          <h3 class="text-lg font-bold mb-2">Will my homeowner's insurance cover foundation repair?</h3>
          <p class="text-gray-700">In most cases, standard Texas homeowner's insurance does not cover foundation repair caused by soil movement or settling — which is the most common cause in Tyler. Insurance typically only covers foundation damage caused by a sudden, covered event like a burst pipe. It's always worth reviewing your specific policy and filing a claim if you believe the damage may qualify.</p>
        </div>
        <div class="border-b border-gray-200 pb-6">
          <h3 class="text-lg font-bold mb-2">Do foundation repairs come with a warranty?</h3>
          <p class="text-gray-700">Yes — most licensed foundation repair contractors in our network offer a lifetime transferable warranty on their pier work. This means if you sell your home, the warranty transfers to the new owner, which can be a significant selling point. Always ask to see the warranty in writing before work begins.</p>
        </div>
        <div class="pb-6">
          <h3 class="text-lg font-bold mb-2">What's the difference between slab and pier-and-beam foundations?</h3>
          <p class="text-gray-700">A <a href="/slab-foundation-repair" class="text-brand font-semibold hover:underline">slab foundation</a> is a single continuous pour of concrete that your home sits directly on — common in Tyler homes built after 1960. A <a href="/pier-beam-repair" class="text-brand font-semibold hover:underline">pier-and-beam foundation</a> raises the home on wooden beams supported by concrete or wooden piers, leaving a crawl space underneath — typical in Tyler's older and historic neighborhoods.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection
    heading="Get Your Free Foundation Inspection"
    subtext="We'll send a local Tyler expert to your home — no charge, no pressure. You'll get a clear assessment of what's happening, what needs to be done, and what it will cost. No upsells, no scare tactics."
    buttonText="Schedule Your Free Inspection → (903) 582-7837"
  />
</Layout>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does foundation repair cost in Tyler, TX?",
      "acceptedAnswer": { "@type": "Answer", "text": "Foundation repair in Tyler typically ranges from $3,500 to $15,000 depending on the severity of the damage and the number of piers required. Minor repairs involving 2–4 piers average $4,000–$6,000. Severe settlement affecting the entire slab can run $10,000–$20,000." }
    },
    {
      "@type": "Question",
      "name": "What causes foundation problems in Tyler, Texas?",
