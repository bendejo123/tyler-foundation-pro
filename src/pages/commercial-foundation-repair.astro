---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import CTASection from '../components/CTASection.astro';
import SignsList from '../components/SignsList.astro';

const issues = [
  'Slab settlement under office buildings, retail spaces, and restaurants',
  'Warehouse floor cracking and differential settlement',
  'Brick facade separation and cracking in commercial storefronts',
  'Door and storefront frame misalignment',
  'Cracked interior flooring in commercial kitchens, showrooms, or retail spaces',
  'Loading dock and exterior slab settlement',
];

const propertyTypes = [
  'Office buildings along Loop 323 and Troup Highway',
  'Retail and strip centers',
  'Restaurant and food service facilities',
  'Churches and nonprofit facilities',
  'Medical and dental offices',
  'Light industrial and warehouse buildings',
];
---

<Layout
  title="Commercial Foundation Repair in Tyler, TX | Tyler Foundation Pros"
  description="Commercial foundation problems in Tyler or East Texas? We connect you with licensed contractors for office buildings, retail spaces, and warehouses. Free assessment. Call (903) 582-7837."
>
  <HeroSection
    h1="Commercial Foundation Repair in Tyler, TX"
    subheading="East Texas clay soil doesn't discriminate between residential and commercial structures. We connect you with licensed contractors who handle commercial foundation work of all sizes."
    buttonText="Call (903) 582-7837 — Free Commercial Assessment"
  />

  <section class="py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-gray-700 text-lg mb-4">
        East Texas clay soil doesn't discriminate between residential and commercial structures. Office buildings, retail centers, warehouses, restaurants, and churches across Tyler and Smith County experience the same foundation movement that affects homes — often at greater scale and with greater consequences.
      </p>
      <p class="text-gray-700 text-lg">
        A foundation problem in a commercial building is a liability issue, a code compliance issue, and a business interruption issue. The licensed contractors in our network take commercial work seriously and work around your operating schedule.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-6">Commercial Foundation Issues We Address</h2>
      <SignsList items={issues} />
    </div>
  </section>

  <section class="py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-8">The Commercial Repair Process</h2>
      <div class="space-y-6">
        <div class="border-l-4 border-brand pl-6">
          <h3 class="text-xl font-bold mb-2">Site Assessment</h3>
          <p class="text-gray-600">The contractor starts with a thorough site assessment — reviewing your building's construction type, age, drainage, and visible damage. For larger structures, they can coordinate with your structural engineer.</p>
        </div>
        <div class="border-l-4 border-brand pl-6">
          <h3 class="text-xl font-bold mb-2">Minimal Disruption</h3>
          <p class="text-gray-600">Work is scheduled around your business hours wherever possible. Most commercial pier installations can be staged so that only a portion of your facility is affected at any given time.</p>
        </div>
        <div class="border-l-4 border-brand pl-6">
          <h3 class="text-xl font-bold mb-2">Documentation</h3>
          <p class="text-gray-600">Before-and-after measurement documentation is provided, which is often required for insurance claims or building permit compliance.</p>
        </div>
        <div class="border-l-4 border-brand pl-6">
          <h3 class="text-xl font-bold mb-2">Warranty</h3>
          <p class="text-gray-600">Many contractors in our network offer lifetime transferable warranties on commercial repairs. Ask the contractor for their specific warranty terms before work begins.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-6">Common Commercial Properties We Serve in Tyler</h2>
      <SignsList items={propertyTypes} />
    </div>
  </section>

  <CTASection
    heading="Request a Commercial Foundation Assessment"
    subtext="Call us to get connected with a licensed contractor for a no-cost site assessment. You'll get a frank evaluation, a repair plan, and a written estimate — no pressure."
    buttonText="Call (903) 582-7837 — Free Commercial Assessment"
  />
</Layout>
