---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import CTASection from '../components/CTASection.astro';
import SignsList from '../components/SignsList.astro';

const signs = [
  'Diagonal cracks in drywall near door frames and window corners',
  'Doors or windows that stick, drag, or won\'t latch properly',
  'Floors that slope, feel bouncy, or have noticeable dips',
  'Gaps forming between walls and the ceiling or floor',
  'Cracks in exterior brick, stone, or mortar joints',
  'Water pooling near the foundation after rain',
];
---

<Layout
  title="Foundation Repair in Jacksonville, TX | Tyler Foundation Pros"
  description="Foundation settling or cracking in Jacksonville, TX? Tyler Foundation Pros connects Jacksonville homeowners with licensed local repair contractors. Free inspection. Call (903) 582-7837."
>
  <HeroSection
    h1="Foundation Repair in Jacksonville, TX"
    subheading="Tyler Foundation Pros connects Jacksonville homeowners and businesses with licensed, experienced foundation repair contractors — free inspections, fast response, local expertise."
    buttonText="Call (903) 582-7837 — Free Jacksonville Inspection"
  />

  <section class="py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-gray-700 text-lg mb-4">
        Jacksonville sits in Cherokee County, just 30 miles south of Tyler on US-69. Like the rest of East Texas, Jacksonville is built on expansive clay-heavy soil — the same soil responsible for the foundation problems that affect tens of thousands of homeowners across the region every year.
      </p>
      <p class="text-gray-700 text-lg">
        Whether your home is in an established neighborhood near Jacksonville High School or a newer subdivision on the outskirts of town, Tyler Foundation Pros can connect you with a licensed local contractor who knows Cherokee County soil conditions — at no cost to get started.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">Why Jacksonville Homes Develop Foundation Problems</h2>
      <p class="text-gray-700 mb-4">
        Cherokee County's soil is part of the same East Texas clay belt that causes foundation movement across the region. During wet seasons, the clay swells against your foundation. During Jacksonville's dry summers, it contracts and pulls away — leaving voids beneath your slab that cause settling and cracking.
      </p>
      <p class="text-gray-700 mb-4">
        Homes in older Jacksonville neighborhoods often have pier-and-beam foundations, which are susceptible to wood rot, termite damage, and settling as the piers shift over time. Newer homes on slabs face the constant pressure of reactive clay with each seasonal moisture cycle.
      </p>
      <p class="text-gray-700">
        The good news: foundation problems in Jacksonville are well understood and reliably fixable. Licensed contractors use steel push pier systems that drive past the reactive clay layer to stable bearing soil — typically 15–25 feet deep in Cherokee County — for a permanent solution.
      </p>
    </div>
  </section>

  <section class="py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-6">Warning Signs to Watch For in Jacksonville</h2>
      <SignsList items={signs} />
      <p class="mt-6 text-gray-700">
        Seeing one or more of these? Don't wait. Foundation issues in East Texas compound quickly. A repair that runs $4,000–$6,000 today can double in cost within two years if the settlement continues. Call us for a free inspection: <a href="tel:9035827837" class="text-brand font-semibold hover:underline">(903) 582-7837</a>.
      </p>
    </div>
  </section>

  <section class="bg-gray-50 py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">Foundation Repair Services in Jacksonville</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-white border border-gray-200 rounded p-5">
          <h3 class="font-bold mb-2"><a href="/slab-foundation-repair" class="hover:underline text-brand">Slab Foundation Repair</a></h3>
          <p class="text-gray-600 text-sm">Steel push piers driven to stable bearing soil, hydraulic lifting, and permanent stabilization for settled concrete slabs.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded p-5">
          <h3 class="font-bold mb-2"><a href="/pier-beam-repair" class="hover:underline text-brand">Pier &amp; Beam Repair</a></h3>
          <p class="text-gray-600 text-sm">Beam replacement, pier resetting, and crawl space leveling for Jacksonville's older homes.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded p-5">
          <h3 class="font-bold mb-2"><a href="/house-leveling" class="hover:underline text-brand">House Leveling</a></h3>
          <p class="text-gray-600 text-sm">Differential settlement correction to restore level floors and properly aligned doors and windows.</p>
        </div>
        <div class="bg-white border border-gray-200 rounded p-5">
          <h3 class="font-bold mb-2"><a href="/commercial-foundation-repair" class="hover:underline text-brand">Commercial Foundation Repair</a></h3>
          <p class="text-gray-600 text-sm">Foundation stabilization for Jacksonville commercial properties — retail, office, and industrial.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold mb-4">Free Foundation Inspection for Jacksonville Homeowners</h2>
      <p class="text-gray-700 mb-4">
        Call our local (903) number and we'll schedule a licensed contractor to inspect your foundation at no charge — typically within 48 hours. You'll receive a written estimate with clear pricing and no obligation.
      </p>
      <p class="text-gray-700">
        We also serve nearby communities in Cherokee County including Rusk, Alto, and New Summerfield. Call <a href="tel:9035827837" class="text-brand font-semibold hover:underline">(903) 582-7837</a> to confirm we cover your area.
      </p>
    </div>
  </section>

  <CTASection
    heading="Schedule Your Free Jacksonville Inspection"
    subtext="Local contractors. Free estimate. No pressure. We'll assess your foundation and explain exactly what needs to be done — in plain English."
    buttonText="Call (903) 582-7837 — Free Inspection"
  />
</Layout>
