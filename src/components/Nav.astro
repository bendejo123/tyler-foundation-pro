---
---

<header class="sticky top-0 z-50 bg-white border-b border-gray-200">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="text-xl font-bold text-black tracking-tight flex-shrink-0">
        Tyler Foundation Pros
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-6">
        <!-- Services Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 text-sm font-medium text-black hover:text-brand transition-colors py-2">
            Services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            <div class="bg-white border border-gray-200 rounded shadow-lg min-w-[220px] py-1">
              <a href="/slab-foundation-repair" class="block px-4 py-2 text-sm text-black hover:bg-gray-50 hover:text-brand">Slab Foundation Repair</a>
              <a href="/pier-beam-repair" class="block px-4 py-2 text-sm text-black hover:bg-gray-50 hover:text-brand">Pier &amp; Beam Repair</a>
              <a href="/house-leveling" class="block px-4 py-2 text-sm text-black hover:bg-gray-50 hover:text-brand">House Leveling</a>
              <a href="/commercial-foundation-repair" class="block px-4 py-2 text-sm text-black hover:bg-gray-50 hover:text-brand">Commercial Foundation Repair</a>
            </div>
          </div>
        </div>

        <!-- Service Areas Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 text-sm font-medium text-black hover:text-brand transition-colors py-2">
            Service Areas
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute left-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            <div class="bg-white border border-gray-200 rounded shadow-lg min-w-[200px] py-1">
              <a href="/lindale-tx" class="block px-4 py-2 text-sm text-black hover:bg-gray-50 hover:text-brand">Lindale</a>
              <a href="/whitehouse-tx" class="block px-4 py-2 text-sm text-black hover:bg-gray-50 hover:text-brand">Whitehouse</a>
              <a href="/bullard-tx" class="block px-4 py-2 text-sm text-black hover:bg-gray-50 hover:text-brand">Bullard</a>
              <a href="/flint-tx" class="block px-4 py-2 text-sm text-black hover:bg-gray-50 hover:text-brand">Flint / Gresham</a>
              <a href="/hideaway-tx" class="block px-4 py-2 text-sm text-black hover:bg-gray-50 hover:text-brand">Hideaway</a>
              <a href="/chandler-tx" class="block px-4 py-2 text-sm text-black hover:bg-gray-50 hover:text-brand">Chandler</a>
            </div>
          </div>
        </div>

        <!-- CTA Button -->
        <a
          href="tel:9035551234"
          class="ml-2 bg-brand text-white text-sm font-semibold px-4 py-2 rounded hover:bg-[#b84200] transition-colors"
        >
          Call (903) 555-1234
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-black"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-200 pb-4">
      <div class="pt-3 space-y-1">
        <p class="px-2 py-1 text-xs font-semibold text-gray-500 uppercase tracking-wider">Services</p>
        <a href="/slab-foundation-repair" class="block px-2 py-2 text-sm text-black hover:text-brand">Slab Foundation Repair</a>
        <a href="/pier-beam-repair" class="block px-2 py-2 text-sm text-black hover:text-brand">Pier &amp; Beam Repair</a>
        <a href="/house-leveling" class="block px-2 py-2 text-sm text-black hover:text-brand">House Leveling</a>
        <a href="/commercial-foundation-repair" class="block px-2 py-2 text-sm text-black hover:text-brand">Commercial Foundation Repair</a>

        <p class="px-2 pt-3 py-1 text-xs font-semibold text-gray-500 uppercase tracking-wider">Service Areas</p>
        <a href="/lindale-tx" class="block px-2 py-2 text-sm text-black hover:text-brand">Lindale</a>
        <a href="/whitehouse-tx" class="block px-2 py-2 text-sm text-black hover:text-brand">Whitehouse</a>
        <a href="/bullard-tx" class="block px-2 py-2 text-sm text-black hover:text-brand">Bullard</a>
        <a href="/flint-tx" class="block px-2 py-2 text-sm text-black hover:text-brand">Flint / Gresham</a>
        <a href="/hideaway-tx" class="block px-2 py-2 text-sm text-black hover:text-brand">Hideaway</a>
        <a href="/chandler-tx" class="block px-2 py-2 text-sm text-black hover:text-brand">Chandler</a>

        <div class="pt-3 px-2">
          <a
            href="tel:9035551234"
            class="block bg-brand text-white text-sm font-semibold px-4 py-3 rounded text-center hover:bg-[#b84200] transition-colors"
          >
            Call (903) 555-1234
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    btn?.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
